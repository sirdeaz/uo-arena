; Chrome theme for the join screen so its controls stop being stock engine grey (#19).
; The colours mirror client/palette.gd — UI_PANEL #11141c, UI_BORDER #3a4050,
; UI_TEXT #c8d0e0 — kept in sync by hand; the palette module stays the source of record.
[gd_resource type="Theme" load_steps=6 format=3]

